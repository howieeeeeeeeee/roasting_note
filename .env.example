# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this-to-a-long-random-string

# MongoDB Configuration
# Example: mongodb+srv://username:password@cluster.mongodb.net/roastlogger?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_URI_LOCAL=mongodb://localhost:27017/
DEFAULT_DB=local

# Required for applied database sync. Use a unique, stable value per machine.
# Example: DEVICE=howie-macbook-air
DEVICE=

# Operator timezone for application-created datetimes and UI timestamp display.
# MongoDB stores BSON Date values as UTC instants; the UI converts them here.
TIMEZONE=America/New_York

# K-Type Temperature Sensor Configuration
# URL of the local temperature sensor endpoint (Howie's design K-Type Sensor V1)
# The sensor should return JSON in format: {"temperature_celsius": 73.75, "temperature_fahrenheit": 164.75}
TEMP_SENSOR_URL=http://192.168.0.47/temp
